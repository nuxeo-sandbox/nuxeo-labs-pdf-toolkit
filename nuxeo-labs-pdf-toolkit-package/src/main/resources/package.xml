<!-- See documentation at http://doc.nuxeo.com/x/HgIz -->
<package type="addon" name="nuxeo-labs-pdf-toolkit" version="@VERSION@">
  <title>Nuxeo labs pdf toolkit</title>
  <description>
    <p>Adds a "PDF Toolkit" action to PDF documents in the Web UI: display the page thumbnails,
      select pages, reorder them by drag and drop, then extract, remove or reorder pages.</p>
    <p>The result can be downloaded, saved as a derivative document, added to the attachments, or used
      to replace the main file (with optional versioning).</p>
    <p>Also provides six Automation operations (PDFLabs.*) usable outside the UI.</p>
  </description>
  <!-- <home-page>http://doc.nuxeo.com/</home-page> -->
  <vendor>Hyland</vendor>
  <installer restart="true" />
  <uninstaller restart="true" />
  <!-- <hotreload-support>false</hotreload-support> -->
  <!-- <require-terms-and-conditions-acceptance>false</require-terms-and-conditions-acceptance> -->
  <!-- Nuxeo Validation: none | inprocess | primary_validation | nuxeo_certified -->
  <nuxeo-validation>none</nuxeo-validation>
  <!-- Production State: production_ready | testing | proto -->
  <production-state>testing</production-state>
  <supported>false</supported>
  <target-platform>
    <name>lts</name>
    <version>[@NUXEO_TARGET_VERSION@,)</version>
  </target-platform>
  <!-- Dependencies on other packages -->
  <!-- The plugin ships Web UI resources and appends to the Web UI i18n files: it cannot work without it. -->
  <dependencies>
    <package>nuxeo-web-ui</package>
  </dependencies>
  <!-- Conflicts with other packages -->
  <!-- <conflicts> -->
  <!-- <package>a-conflicting-package:1.0.0:1.0.0</package> -->
  <!-- </conflicts> -->
  <!-- Provides features of other packages -->
  <!-- <provides> -->
  <!-- <package>an-embedded-package:1.0.0:1.0.0</package> -->
  <!-- </provides> -->
  <license>Apache License, Version 2.0</license>
  <license-url>http://www.apache.org/licenses/LICENSE-2.0.html</license-url>
  <!-- Visibility: PRIVATE | MARKETPLACE | DEV | PUBLIC -->
  <visibility>DEV</visibility>
</package>
